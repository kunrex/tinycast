    "NSAppleEventsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast verwendet Automation nur für Systemaktionen, die du ausdrücklich ausführst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast uses automation to perform system actions you explicitly run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast usa la automatización para realizar las acciones del sistema que ejecutas expresamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast utilise l’automatisation pour exécuter des actions dans d’autres apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycastは、あなたが明示的に実行するシステムアクションにオートメーションを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast는 사용자가 직접 실행하는 시스템 동작을 수행할 때 자동화를 사용합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tinycast usa automação para realizar as ações do sistema que você executa explicitamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast использует автоматизацию для выполнения системных действий, которые вы запускаете явно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast 使用自动化来执行你主动运行的系统操作。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast greift nur auf Bluetooth zu, wenn du die Aktion „Bluetooth umschalten“ ausführst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast uses Bluetooth access only when you run the Toggle Bluetooth action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast solo accede a Bluetooth cuando ejecutas la acción de activar o desactivar Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast accède au Bluetooth uniquement lorsque vous lancez l’action d’activation ou de désactivation du Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycastは、Bluetoothの切り替えアクションを実行したときのみBluetoothにアクセスします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast는 Bluetooth 전환 동작을 실행할 때에만 Bluetooth에 접근합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tinycast acessa o Bluetooth apenas quando você executa a ação de ativar ou desativar o Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast обращается к Bluetooth только при запуске действия переключения Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast 仅在你运行切换蓝牙操作时访问蓝牙。"
          }
        }
      }
    },
