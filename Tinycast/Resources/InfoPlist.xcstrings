    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast nimmt Audio nur auf, während du das Diktat verwendest, und wandelt es auf deinem Mac in Text um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast records audio only while you use Dictation, to transcribe it on your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast solo graba audio mientras usas Dictado para transcribirlo en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast enregistre l’audio uniquement lorsque vous utilisez la dictée, pour le transcrire sur votre Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycastは音声入力の使用中のみ音声を録音し、Mac上で文字に起こします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast는 받아쓰기를 사용하는 동안에만 오디오를 녹음하여 Mac에서 텍스트로 변환합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tinycast grava áudio apenas enquanto você usa o Ditado, para transcrevê-lo no seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast записывает звук только во время диктовки и преобразует его в текст на вашем Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast 仅在你使用听写时录制音频，并在你的 Mac 上将其转为文字。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast erlaubt Erweiterungen, die du ausführst, deine Erinnerungen zu lesen und zu bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast lets extensions you run read and edit your reminders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast permite que las extensiones que ejecutas lean y editen tus recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast permet aux extensions que vous lancez de lire et de modifier vos rappels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycastは、あなたが実行する拡張機能にリマインダーの読み取りと編集を許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast는 사용자가 실행하는 확장 프로그램이 미리 알림을 읽고 편집할 수 있게 합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tinycast permite que as extensões que você executa leiam e editem seus lembretes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast позволяет запускаемым вами расширениям читать и редактировать ваши напоминания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinycast 允许你运行的扩展读取和编辑你的提醒事项。"
          }
        }
      }
